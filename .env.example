# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_token_here

# Optional: a guild ID for instant slash-command sync during dev.
# Leave empty for global sync (can take up to ~1 hour to propagate).
DEV_GUILD_ID=

# Optional: bot presence string shown under its name.
ACTIVITY_STATUS="Always monitoring your behavior"

# Optional: where the SQLite DB lives. Defaults to data/bot.sqlite3
# (resolved relative to the bot's working directory).
BOT_DB_PATH=

# Optional: logging level (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
LOG_LEVEL=
